# Fill these two values locally before starting PostgreSQL or running pnpm db:*.
# Keep the same URL-safe password in both places. This file intentionally has no usable default.
POSTGRES_PASSWORD=
DATABASE_URL=
WKNOWLEDGE_DATA_ROOT=./data/spaces
WKNOWLEDGE_BLOB_ROOT=./data/blobs
WKNOWLEDGE_WORKSPACE_ROOT=.
WKNOWLEDGE_SESSION_SECRET=replace-with-at-least-32-random-characters
WKNOWLEDGE_BOOTSTRAP_EMAIL=admin@example.com
WKNOWLEDGE_BOOTSTRAP_PASSWORD=change-me-before-production
WKNOWLEDGE_BOOTSTRAP_NAME=知识库管理员

# 可选：OpenAI-compatible 单轮有据问答。BASE_URL 与 MODEL 同时存在才启用。
WKNOWLEDGE_CHAT_PROVIDER_ID=openai-compatible
WKNOWLEDGE_CHAT_BASE_URL=
WKNOWLEDGE_CHAT_MODEL=
WKNOWLEDGE_CHAT_LOCATION=local
WKNOWLEDGE_CHAT_API_KEY=
WKNOWLEDGE_CHAT_TIMEOUT_MS=20000

# 管理页保存云模型 API Key 时必填：32 字节随机值的 base64url 编码。
WKNOWLEDGE_CREDENTIAL_KEY=

# 可选：Compose Worker cgroup/临时盘覆盖值；未设置时分别为 2g、2.0、256、1g。
WKNOWLEDGE_WORKER_MEMORY_LIMIT=
WKNOWLEDGE_WORKER_CPU_LIMIT=
WKNOWLEDGE_WORKER_PIDS_LIMIT=
WKNOWLEDGE_WORKER_TMPFS_SIZE=
